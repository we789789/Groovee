<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="mainPanel" prefHeight="649.0" prefWidth="996.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="FrontEnd.ProductDetails">
   <children>
      <TableView fx:id="tbl_productDetails" layoutX="21.0" layoutY="97.0" prefHeight="536.0" prefWidth="952.0">
        <columns>
          <TableColumn fx:id="col_productID" prefWidth="96.0" text="Product ID" />
          <TableColumn fx:id="col_productName" prefWidth="408.0" text="Product Name" />
            <TableColumn fx:id="col_purchasingPrice" prefWidth="153.0" text="Purchasing Price" />
            <TableColumn fx:id="col_sellingPrice" prefWidth="154.0" text="Selling Price" />
            <TableColumn fx:id="col_quantity" prefWidth="140.0" text="Quantity" />
        </columns>
      </TableView>
      <Button layoutX="21.0" layoutY="23.0" mnemonicParsing="false" onAction="#btn_MainMenu" prefHeight="41.0" prefWidth="237.0" style="-fx-background-color: #169bee; -fx-border-radius: 10px;" text="Main Menu" textAlignment="CENTER" textFill="WHITE" />
      <Button layoutX="861.0" layoutY="23.0" minWidth="30.0" mnemonicParsing="false" onAction="#btn_search" prefHeight="41.0" prefWidth="54.0" style="-fx-background-color: #169bee;" text="🔍" textFill="WHITE">
         <cursor>
            <Cursor fx:constant="HAND" />
         </cursor>
         <font>
            <Font size="15.0" />
         </font>
      </Button>
      <TextField fx:id="txt_searchField" layoutX="471.0" layoutY="23.0" onKeyPressed="#search" prefHeight="41.0" prefWidth="384.0" promptText="Search Products" />
   </children>
</AnchorPane>
