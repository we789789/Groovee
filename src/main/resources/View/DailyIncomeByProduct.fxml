<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="mainPanel" prefHeight="649.0" prefWidth="996.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="FrontEnd.incomesByProduct">
    <children>
        <TableView fx:id="tbl_dailyProfit" layoutX="21.0" layoutY="97.0" prefHeight="473.0" prefWidth="952.0">
            <columns>
                <TableColumn fx:id="col_dailyProfitProductID" prefWidth="96.0" text="Product ID" />
                <TableColumn fx:id="col_dailyProfitProductName" prefWidth="408.0" text="Product Name" />
                <TableColumn fx:id="col_dailyProfitPurchasingPrice" prefWidth="153.0" text="Purchasing Price" />
                <TableColumn fx:id="col_dailyProfitSellingPrice" prefWidth="154.0" text="Selling Price" />
                <TableColumn fx:id="col_dailyProfitQuantity" prefWidth="140.0" text="Profit" />
            </columns>
        </TableView>
        <Button layoutX="21.0" layoutY="23.0" mnemonicParsing="false" onAction="#btn_MainMenu" prefHeight="41.0" prefWidth="237.0" style="-fx-background-color: #169bee; -fx-border-radius: 10px;" text="Main Menu" textAlignment="CENTER" textFill="WHITE" />
        <Button layoutX="861.0" layoutY="23.0" minWidth="30.0" mnemonicParsing="false" onAction="#btn_search" prefHeight="41.0" prefWidth="54.0" style="-fx-background-color: #169bee;" text="🔍" textFill="WHITE">
            <cursor>
                <Cursor fx:constant="HAND" />
            </cursor>
            <font>
                <Font size="15.0" />
            </font>
        </Button>
        <TextField fx:id="txt_searchField" layoutX="471.0" layoutY="23.0" onKeyPressed="#search" prefHeight="41.0" prefWidth="384.0" promptText="Search Products" />
      <Label layoutX="615.0" layoutY="599.0" prefHeight="25.0" prefWidth="97.0" text="Total Profit :">
         <font>
            <Font size="16.0" />
         </font>
      </Label>
      <Label layoutX="712.0" layoutY="599.0" prefHeight="25.0" prefWidth="237.0" textFill="#04ff00">
         <font>
            <Font size="16.0" />
         </font>
      </Label>
    </children>
</AnchorPane>
