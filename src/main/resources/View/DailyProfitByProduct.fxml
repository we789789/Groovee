<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ButtonBar?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="mainPanel" prefHeight="649.0" prefWidth="996.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="FrontEnd.incomesByProductDaily">
    <children>
        <TableView fx:id="tbl_dailyProfit" layoutX="13.0" layoutY="114.0" prefHeight="466.0" prefWidth="970.0">
            <columns>
            <TableColumn fx:id="col_dailyProfitDate" prefWidth="168.0" text="Date" />
                <TableColumn fx:id="col_dailyProfitProductID" prefWidth="113.0" text="Product ID" />
                <TableColumn fx:id="col_dailyProfitProductName" prefWidth="302.0" text="Product Name" />
                <TableColumn fx:id="col_dailyProfitPurchasingPrice" prefWidth="136.0" text="Purchasing Price" />
                <TableColumn fx:id="col_dailyProfitSellingPrice" prefWidth="136.0" text="Selling Price" />
                <TableColumn fx:id="col_dailyProfit" prefWidth="114.0" text="Profit" />
            </columns>
        </TableView>
        <Button layoutX="21.0" layoutY="23.0" mnemonicParsing="false" onAction="#btn_MainMenu" prefHeight="41.0" prefWidth="237.0" style="-fx-background-color: #169bee; -fx-border-radius: 10px;" text="Main Menu" textAlignment="CENTER" textFill="WHITE" />
        <TextField fx:id="txt_searchField" layoutX="477.0" layoutY="23.0" onKeyReleased="#search" prefHeight="41.0" prefWidth="507.0" promptText="Search Products" />
      <Label layoutX="615.0" layoutY="599.0" prefHeight="25.0" prefWidth="97.0" text="Total Profit :">
         <font>
            <Font size="16.0" />
         </font>
      </Label>
      <Label fx:id="lbl_dailyTotalProfit" layoutX="712.0" layoutY="599.0" prefHeight="25.0" prefWidth="237.0" textFill="#04ff00">
         <font>
            <Font size="16.0" />
         </font>
      </Label>
      <ButtonBar layoutX="45.0" layoutY="592.0" prefHeight="40.0" prefWidth="359.0" style="align-items: center;">
         <buttons>
            <Button mnemonicParsing="false" onMouseReleased="#btnYearly" prefHeight="30.0" prefWidth="145.0" style="-fx-background-color: #169bee;" text="Yearly" textFill="WHITE" />
            <Button mnemonicParsing="false" onMouseReleased="#btnMonthly" prefHeight="31.0" style="-fx-background-color: #169bee;" text="Monthly" textAlignment="CENTER" textFill="WHITE" />
            <Button mnemonicParsing="false" prefHeight="24.0" prefWidth="162.0" style="-fx-background-color: #2d3af8;" text="Daily" textFill="WHITE">
               <cursor>
                  <Cursor fx:constant="DISAPPEAR" />
               </cursor>
            </Button>
         </buttons>
         <opaqueInsets>
            <Insets />
         </opaqueInsets>
         <cursor>
            <Cursor fx:constant="DEFAULT" />
         </cursor>
      </ButtonBar>
    </children>
</AnchorPane>
