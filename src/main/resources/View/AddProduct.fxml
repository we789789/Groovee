      <Label fx:id="lbl_Success" contentDisplay="CENTER" layoutX="117.0" layoutY="359.0" prefHeight="25.0" prefWidth="312.0" style="-fx-font-color: #00ff12; -fx-text-alignment: center;" textAlignment="CENTER" textFill="#00ff12" />
